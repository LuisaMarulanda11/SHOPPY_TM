{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://shoppy-tm-snowy.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://shoppy-tm-snowy.vercel.app/uploads/:path*" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
